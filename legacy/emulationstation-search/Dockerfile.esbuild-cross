# x86 host, armhf cross-toolchain. cmake runs natively so file(GLOB)
# works -- under ARM emulation it silently returns nothing and breaks
# both compiler detection and find_package().
FROM debian:bookworm

ENV DEBIAN_FRONTEND=noninteractive
RUN set -eux; \
    for i in 1 2 3; do \
      apt-get update -o Acquire::Retries=3 && \
      apt-get install -y --no-install-recommends \
        crossbuild-essential-armhf \
        cmake pkg-config git ca-certificates file symlinks \
      && break || { rm -rf /var/lib/apt/lists/*; sleep 5; }; \
    done; \
    rm -rf /var/lib/apt/lists/*
WORKDIR /src
