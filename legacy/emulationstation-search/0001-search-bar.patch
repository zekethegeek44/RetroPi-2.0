diff --git a/es-core/src/guis/GuiOnScreenKeyboard.cpp b/es-core/src/guis/GuiOnScreenKeyboard.cpp
new file mode 100644
index 0000000..62b5425
--- /dev/null
+++ b/es-core/src/guis/GuiOnScreenKeyboard.cpp
@@ -0,0 +1,167 @@
+#include "guis/GuiOnScreenKeyboard.h"
+
+#include "components/ButtonComponent.h"
+#include "components/MenuComponent.h"
+#include "components/TextComponent.h"
+#include "utils/StringUtil.h"
+
+#include <algorithm>
+
+namespace
+{
+	// 10 columns wide. Rows are padded to 10 so the grid stays rectangular.
+	const int KB_COLS = 10;
+	const int KB_ROWS = 4;
+
+	const char* KEYS[KB_ROWS][KB_COLS] = {
+		{ "1", "2", "3", "4", "5", "6", "7", "8", "9", "0" },
+		{ "Q", "W", "E", "R", "T", "Y", "U", "I", "O", "P" },
+		{ "A", "S", "D", "F", "G", "H", "J", "K", "L", "-" },
+		{ "Z", "X", "C", "V", "B", "N", "M", ",", ".", "'" }
+	};
+
+	// Row 0 title, row 1 the typed text, rows 2..5 keys, row 6 buttons.
+	const int ROW_TITLE   = 0;
+	const int ROW_TEXT    = 1;
+	const int ROW_KEYS    = 2;
+	const int ROW_BUTTONS = ROW_KEYS + KB_ROWS;
+	const int GRID_ROWS   = ROW_BUTTONS + 1;
+}
+
+GuiOnScreenKeyboard::GuiOnScreenKeyboard(Window* window, const std::string& title, const std::string& initValue,
+	const std::function<void(const std::string&)>& okCallback)
+	: GuiComponent(window),
+	  mBackground(window, ":/frame.png"),
+	  mGrid(window, Vector2i(KB_COLS, GRID_ROWS)),
+	  mValue(initValue),
+	  mOkCallback(okCallback)
+{
+	addChild(&mBackground);
+	addChild(&mGrid);
+
+	mTitle = std::make_shared<TextComponent>(mWindow, Utils::String::toUpper(title),
+		Font::get(FONT_SIZE_LARGE), 0x555555FF, ALIGN_CENTER);
+	mGrid.setEntry(mTitle, Vector2i(0, ROW_TITLE), false, true, Vector2i(KB_COLS, 1));
+
+	mTextDisplay = std::make_shared<TextComponent>(mWindow, "",
+		Font::get(FONT_SIZE_MEDIUM), 0x777777FF, ALIGN_CENTER);
+	mGrid.setEntry(mTextDisplay, Vector2i(0, ROW_TEXT), false, true, Vector2i(KB_COLS, 1),
+		GridFlags::BORDER_TOP | GridFlags::BORDER_BOTTOM);
+	refreshDisplay();
+
+	// One button per key. ButtonComponent already handles the focus
+	// highlight, so navigation comes free from ComponentGrid.
+	std::shared_ptr<ButtonComponent> firstLetter;
+	for (int r = 0; r < KB_ROWS; r++)
+	{
+		for (int c = 0; c < KB_COLS; c++)
+		{
+			const std::string key = KEYS[r][c];
+			auto btn = std::make_shared<ButtonComponent>(mWindow, key, key,
+				[this, key] { appendChar(key); });
+			mGrid.setEntry(btn, Vector2i(c, ROW_KEYS + r), true, false);
+			if (r == 1 && c == 0)
+				firstLetter = btn;
+		}
+	}
+
+	std::vector< std::shared_ptr<ButtonComponent> > buttons;
+	buttons.push_back(std::make_shared<ButtonComponent>(mWindow, "SPACE", "space",
+		[this] { appendChar(" "); }));
+	buttons.push_back(std::make_shared<ButtonComponent>(mWindow, "DEL", "backspace",
+		[this] { backspace(); }));
+	buttons.push_back(std::make_shared<ButtonComponent>(mWindow, "CLEAR", "clear",
+		[this] { clearAll(); }));
+	buttons.push_back(std::make_shared<ButtonComponent>(mWindow, "SEARCH", "search",
+		[this] { if (mOkCallback) mOkCallback(mValue); delete this; }));
+	buttons.push_back(std::make_shared<ButtonComponent>(mWindow, "CANCEL", "cancel",
+		[this] { delete this; }));
+
+	mButtonGrid = makeButtonGrid(mWindow, buttons);
+	mGrid.setEntry(mButtonGrid, Vector2i(0, ROW_BUTTONS), true, false, Vector2i(KB_COLS, 1));
+
+	setSize(Renderer::getScreenWidth() * 0.9f, Renderer::getScreenHeight() * 0.75f);
+	setPosition((Renderer::getScreenWidth() - mSize.x()) / 2,
+	            (Renderer::getScreenHeight() - mSize.y()) / 2);
+
+	// Start focus on 'Q' rather than a digit.
+	if (firstLetter)
+		mGrid.setCursorTo(firstLetter);
+}
+
+void GuiOnScreenKeyboard::appendChar(const std::string& c)
+{
+	// Keep searches short; nobody types an essay with a d-pad.
+	if (mValue.size() >= 32)
+		return;
+	mValue += c;
+	refreshDisplay();
+}
+
+void GuiOnScreenKeyboard::backspace()
+{
+	if (!mValue.empty())
+		mValue.erase(mValue.size() - 1);
+	refreshDisplay();
+}
+
+void GuiOnScreenKeyboard::clearAll()
+{
+	mValue.clear();
+	refreshDisplay();
+}
+
+void GuiOnScreenKeyboard::refreshDisplay()
+{
+	mTextDisplay->setText(mValue.empty() ? "<type a game name>" : mValue);
+}
+
+void GuiOnScreenKeyboard::onSizeChanged()
+{
+	mBackground.fitTo(mSize, Vector3f::Zero(), Vector2f(-32, -32));
+
+	mGrid.setRowHeightPerc(ROW_TITLE, mTitle->getFont()->getHeight() / mSize.y());
+	mGrid.setRowHeightPerc(ROW_TEXT,  mTextDisplay->getFont()->getHeight() * 1.5f / mSize.y());
+	mGrid.setRowHeightPerc(ROW_BUTTONS, mButtonGrid->getSize().y() / mSize.y());
+	mGrid.setSize(mSize);
+}
+
+bool GuiOnScreenKeyboard::input(InputConfig* config, Input input)
+{
+	if (GuiComponent::input(config, input))
+		return true;
+
+	// B closes without searching.
+	if (config->isMappedTo("b", input) && input.value)
+	{
+		delete this;
+		return true;
+	}
+
+	// X is a shortcut for backspace so you aren't hunting for DEL.
+	if (config->isMappedTo("x", input) && input.value)
+	{
+		backspace();
+		return true;
+	}
+
+	// A physical keyboard still works if one happens to be plugged in.
+	if (input.value && input.type == TYPE_KEY)
+	{
+		if (input.id == SDLK_BACKSPACE)
+		{
+			backspace();
+			return true;
+		}
+	}
+
+	return false;
+}
+
+std::vector<HelpPrompt> GuiOnScreenKeyboard::getHelpPrompts()
+{
+	std::vector<HelpPrompt> prompts = mGrid.getHelpPrompts();
+	prompts.push_back(HelpPrompt("x", "backspace"));
+	prompts.push_back(HelpPrompt("b", "back"));
+	return prompts;
+}
