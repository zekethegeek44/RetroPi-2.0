+#pragma once
+#ifndef ES_CORE_GUIS_GUI_ON_SCREEN_KEYBOARD_H
+#define ES_CORE_GUIS_GUI_ON_SCREEN_KEYBOARD_H
+
+#include "components/ComponentGrid.h"
+#include "components/NinePatchComponent.h"
+#include "GuiComponent.h"
+
+#include <functional>
+#include <string>
+
+class TextComponent;
+
+// A d-pad navigable keyboard, so text can be entered with nothing but a
+// controller. RetroPie's EmulationStation only ships GuiTextEditPopup,
+// which needs a real USB keyboard -- no good on a console sitting under
+// a TV. Keys are laid out on a ComponentGrid so ES's existing focus
+// handling does the navigation for us.
+class GuiOnScreenKeyboard : public GuiComponent
+{
+public:
+	GuiOnScreenKeyboard(Window* window, const std::string& title, const std::string& initValue,
+		const std::function<void(const std::string&)>& okCallback);
+
+	bool input(InputConfig* config, Input input) override;
+	void onSizeChanged() override;
+	std::vector<HelpPrompt> getHelpPrompts() override;
+
+private:
+	void appendChar(const std::string& c);
+	void backspace();
+	void clearAll();
+	void refreshDisplay();
+
+	NinePatchComponent mBackground;
+	ComponentGrid mGrid;
+
+	std::shared_ptr<TextComponent> mTitle;
+	std::shared_ptr<TextComponent> mTextDisplay;
+	std::shared_ptr<ComponentGrid> mButtonGrid;
+
+	std::string mValue;
+	std::function<void(const std::string&)> mOkCallback;
+};
+
+#endif // ES_CORE_GUIS_GUI_ON_SCREEN_KEYBOARD_H
