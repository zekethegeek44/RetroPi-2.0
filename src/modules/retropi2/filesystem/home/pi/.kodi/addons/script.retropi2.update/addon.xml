<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<addon id="script.retropi2.update"
       name="Retro Pi 2.0 Update"
       version="1.0.0"
       provider-name="RetroPi2">
    <requires>
        <import addon="xbmc.python" version="3.0.0"/>
    </requires>
    <extension point="xbmc.python.script" library="default.py">
        <provides>executable</provides>
    </extension>
    <extension point="xbmc.addon.metadata">
        <summary lang="en_GB">Update Retro Pi 2.0 over the network</summary>
        <description lang="en_GB">Updates system packages, emulator cores and Kodi add-ons over WiFi, without reflashing the SD card.</description>
        <platform>linux</platform>
        <license>MIT</license>
    </extension>
</addon>
