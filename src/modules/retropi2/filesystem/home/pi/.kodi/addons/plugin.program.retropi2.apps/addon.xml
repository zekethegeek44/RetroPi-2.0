<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<addon id="plugin.program.retropi2.apps"
       name="Apps"
       version="1.0.0"
       provider-name="Retro Pi 2.0">
    <requires>
        <import addon="xbmc.python" version="3.0.0"/>
    </requires>
    <extension point="xbmc.python.pluginsource" library="default.py">
        <provides>executable</provides>
    </extension>
    <extension point="xbmc.addon.metadata">
        <summary lang="en_GB">The apps on this box</summary>
        <description lang="en_GB">A launcher for what this box does: retro games and YouTube. Picking one opens it full screen, and Back brings you here.</description>
        <platform>all</platform>
        <license>MIT</license>
        <assets>
            <icon>resources/icon.png</icon>
            <fanart>resources/fanart.jpg</fanart>
        </assets>
    </extension>
</addon>
