#!/usr/bin/env python3
"""
Retro Pi 2.0 -- download libretro emulator cores on first boot.

Debian only packages 5 usable cores for arm64, and none of them cover
Genesis, N64, PS1 or arcade. The libretro buildbot has 212 for aarch64,
so we fetch the ones a Pi 4 can actually run.

Runs once, on the Pi, because it needs the network. Best-effort: a core
that fails to download is logged and skipped, never fatal.
"""

import io
import os
import shutil
import sys
import tempfile
import urllib.request
import zipfile

BUILDBOT = "https://buildbot.libretro.com/nightly/linux/aarch64/latest"

HOME = os.environ.get("HOME", "/home/pi")
CORE_DIR = os.path.join(HOME, ".config", "retroarch", "cores")
AUTOCONF_DIR = os.path.join(HOME, ".config", "retroarch", "autoconfig")
AUTOCONF_URL = ("https://codeload.github.com/libretro/"
                "retroarch-joypad-autoconfig/zip/refs/heads/master")
DONE_FLAG = "/var/lib/retropi2/cores-done"

# Chosen for a Pi 4: everything here is comfortably playable, apart from
# flycast/ppsspp which are borderline but worth having.
CORES = [
    # system            core
    ("NES",             "fceumm"),
    ("SNES",            "snes9x"),
    ("Genesis/MD/SMS",  "genesis_plus_gx"),
    ("Sega 32X/CD",     "picodrive"),
    ("Game Boy/Color",  "gambatte"),
    ("Game Boy Advance", "mgba"),
    ("Nintendo 64",     "parallel_n64"),
    ("PlayStation",     "pcsx_rearmed"),
    ("Nintendo DS",     "desmume"),
    ("Atari 2600",      "stella"),
    ("Arcade (MAME)",   "mame2003_plus"),
    ("Arcade (FBNeo)",  "fbneo"),
    ("PSP",             "ppsspp"),
    ("Dreamcast",       "flycast"),
    ("DOS",             "dosbox_pure"),
    ("ScummVM",         "scummvm"),
]

TIMEOUT = 120

# --force re-downloads cores that are already present. Without it an
# "update" would skip everything and silently do nothing.
FORCE = "--force" in sys.argv


def log(msg):
    print("[retropi2-cores] " + str(msg), flush=True)


def fetch(url, timeout=TIMEOUT):
    req = urllib.request.Request(url, headers={"User-Agent": "RetroPi2/1.0"})
    with urllib.request.urlopen(req, timeout=timeout) as r:
        return r.read()


def install_core(name, core):
    target = os.path.join(CORE_DIR, core + "_libretro.so")
    if os.path.exists(target) and not FORCE:
        return True
    url = "%s/%s_libretro.so.zip" % (BUILDBOT, core)
    try:
        data = fetch(url)
        with zipfile.ZipFile(io.BytesIO(data)) as z:
            z.extractall(CORE_DIR)
        log("  + %-18s %s" % (name, core))
        return True
    except Exception as exc:
        log("  ! %-18s %s failed: %s" % (name, core, exc))
        return False


def install_autoconfigs():
    """Controller profiles, so gamepads work without manual mapping.

    RetroArch on Linux uses the udev input driver, so only the udev/
    profiles matter -- about 440 of them, covering essentially any
    gamepad someone is likely to plug in.
    """
    if os.path.isdir(AUTOCONF_DIR) and os.listdir(AUTOCONF_DIR) and not FORCE:
        log("controller profiles already present")
        return True
    log("downloading controller profiles...")
    try:
        data = fetch(AUTOCONF_URL, timeout=180)
    except Exception as exc:
        log("  ! controller profiles failed: %s" % exc)
        return False

    os.makedirs(AUTOCONF_DIR, exist_ok=True)
    tmp = tempfile.mkdtemp()
    try:
        with zipfile.ZipFile(io.BytesIO(data)) as z:
            z.extractall(tmp)
        dirs = [e for e in os.listdir(tmp) if os.path.isdir(os.path.join(tmp, e))]
        if len(dirs) != 1:
            log("  ! unexpected archive layout: %r" % dirs)
            return False
        src = os.path.join(tmp, dirs[0], "udev")
        if not os.path.isdir(src):
            log("  ! no udev/ directory in the archive")
            return False
        n = 0
        for name in os.listdir(src):
            if name.endswith(".cfg"):
                shutil.copy2(os.path.join(src, name),
                             os.path.join(AUTOCONF_DIR, name))
                n += 1
        log("  + %d controller profiles" % n)
        return n > 0
    except Exception as exc:
        log("  ! controller profiles failed: %s" % exc)
        return False
    finally:
        shutil.rmtree(tmp, ignore_errors=True)


def write_retroarch_cfg():
    """Point RetroArch at the downloaded cores and the ROM folder."""
    cfg_dir = os.path.join(HOME, ".config", "retroarch")
    os.makedirs(cfg_dir, exist_ok=True)
    cfg = os.path.join(cfg_dir, "retroarch.cfg")
    if os.path.exists(cfg):
        log("retroarch.cfg already exists; leaving it alone")
        return
    settings = {
        "core_directory": CORE_DIR,
        "joypad_autoconfig_dir": AUTOCONF_DIR,
        "rgui_browser_directory": os.path.join(HOME, "roms"),
        "savefile_directory": os.path.join(HOME, ".config", "retroarch", "saves"),
        "savestate_directory": os.path.join(HOME, ".config", "retroarch", "states"),
        # Kodi owns the screen; let RetroArch take it fullscreen and give
        # it back cleanly on exit.
        "video_fullscreen": "true",
        "video_driver": "gl",
        "menu_driver": "ozone",
        "input_menu_toggle_gamepad_combo": "2",  # Start+Select opens the menu
    }
    for key in ("savefile_directory", "savestate_directory"):
        os.makedirs(settings[key], exist_ok=True)
    with open(cfg, "w", encoding="utf-8") as f:
        for k in sorted(settings):
            f.write('%s = "%s"\n' % (k, settings[k]))
    log("wrote %s" % cfg)


def main():
    os.makedirs(CORE_DIR, exist_ok=True)
    log("downloading emulator cores for aarch64%s..."
        % (" (forced refresh)" if FORCE else ""))

    ok = 0
    for name, core in CORES:
        if install_core(name, core):
            ok += 1

    install_autoconfigs()
    write_retroarch_cfg()

    os.makedirs(os.path.dirname(DONE_FLAG), exist_ok=True)
    with open(DONE_FLAG, "w", encoding="utf-8") as f:
        f.write("installed=%d/%d\n" % (ok, len(CORES)))

    log("done: %d of %d cores installed" % (ok, len(CORES)))
    if ok == 0:
        log("no cores installed -- check the network, then re-run:")
        log("  sudo systemctl start retropi2-addons")
        return 1
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main())
    except Exception as exc:        # never block the boot
        log("unexpected error: %s" % exc)
        sys.exit(1)
