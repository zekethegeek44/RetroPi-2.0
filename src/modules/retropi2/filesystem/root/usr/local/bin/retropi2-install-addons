#!/usr/bin/env python3
"""
Retro Pi 2.0 -- one-time Kodi addon installer.

Runs on the Pi at first boot, because it needs the network and Kodi
addons cannot be resolved at image build time.

Installs:
  * Arctic Horizon 2  -- the dashboard skin (widget rows, Continue Watching)
  * Advanced Kodi Launcher (+ RetroArch plugin) -- games with box art
  * Jellyfin for Kodi -- media server client

Dependencies come from Kodi's official Omega repository where possible;
the two that are not there are pulled from their own GitHub repos.

Everything is best-effort by design: if a repo has moved or the network
is down we log it and let Kodi start on the stock Estuary skin, rather
than leaving a black screen on the TV.
"""

import gzip
import io
import json
import os
import re
import shutil
import sys
import tempfile
import urllib.request
import xml.etree.ElementTree as ET
import zipfile

HOME = os.environ.get("HOME", "/home/pi")
ADDONS = os.path.join(HOME, ".kodi", "addons")
USERDATA = os.path.join(HOME, ".kodi", "userdata")
DONE_FLAG = "/var/lib/retropi2/addons-done"

KODI_REPO = "https://mirrors.kodi.tv/addons/omega"
JM_ZIPS = ("https://raw.githubusercontent.com/jurialmunkey/"
           "repository.jurialmunkey/master/omega/zips")

SKIN_ID = "skin.arctic.horizon.2"

# Pseudo-addons that are part of Kodi itself and are never installable.
BUILTIN = re.compile(r"^(xbmc\.|kodi\.|metadata\.common\.)")

TIMEOUT = 60

# --force reinstalls the addons we manage, so an update actually pulls
# new versions. Dependencies already present are still left alone.
# Addon *settings* live in userdata/, not in the addon directory, so
# replacing the directory does not lose configuration.
FORCE = "--force" in sys.argv


def log(msg):
    print("[retropi2-addons] " + str(msg), flush=True)


def fetch(url, timeout=TIMEOUT):
    req = urllib.request.Request(url, headers={"User-Agent": "RetroPi2/1.0"})
    with urllib.request.urlopen(req, timeout=timeout) as r:
        return r.read()


def load_official_index():
    """Map addon id -> version, from Kodi's official Omega repository."""
    log("fetching official Kodi addon index...")
    raw = fetch(KODI_REPO + "/addons.xml.gz", timeout=180)
    xml = gzip.decompress(raw).decode("utf-8", "replace")
    idx = {}
    for m in re.finditer(r'<addon id="([^"]+)"[^>]*version="([^"]+)"', xml):
        idx.setdefault(m.group(1), m.group(2))
    log("  %d addons in index" % len(idx))
    return idx


def already_installed(addon_id, respect_force=False):
    if respect_force and FORCE:
        return False
    return os.path.isdir(os.path.join(ADDONS, addon_id))


def extract_zip(data, addon_id, strip_root=False):
    """Unpack an addon zip into the Kodi addons directory."""
    os.makedirs(ADDONS, exist_ok=True)
    with zipfile.ZipFile(io.BytesIO(data)) as z:
        if not strip_root:
            z.extractall(ADDONS)
            return
        # GitHub source zips wrap everything in a "<repo>-<branch>/" folder.
        tmp = tempfile.mkdtemp()
        try:
            z.extractall(tmp)
            dirs = [e for e in os.listdir(tmp)
                    if os.path.isdir(os.path.join(tmp, e))]
            if len(dirs) != 1:
                raise RuntimeError("unexpected zip layout: %r" % dirs)
            dest = os.path.join(ADDONS, addon_id)
            shutil.rmtree(dest, ignore_errors=True)
            shutil.move(os.path.join(tmp, dirs[0]), dest)
        finally:
            shutil.rmtree(tmp, ignore_errors=True)


def reconcile_addon_dir(addon_id):
    """Make the directory name match the addon's declared id.

    Kodi identifies an addon by its directory name and refuses to load
    one whose addon.xml declares a different id. At least one upstream
    repo ships a mismatch (resource.font.robotcjksc on disk declaring
    resource.font.robotocjksc), which silently breaks anything that
    depends on it.
    """
    if os.path.isdir(os.path.join(ADDONS, addon_id)):
        return True
    if not os.path.isdir(ADDONS):
        return False
    for name in os.listdir(ADDONS):
        xml = os.path.join(ADDONS, name, "addon.xml")
        if not os.path.isfile(xml):
            continue
        try:
            declared = ET.parse(xml).getroot().get("id")
        except ET.ParseError:
            continue
        if declared == addon_id:
            src = os.path.join(ADDONS, name)
            dst = os.path.join(ADDONS, addon_id)
            log("  renaming %s -> %s (directory did not match addon id)"
                % (name, addon_id))
            shutil.rmtree(dst, ignore_errors=True)
            shutil.move(src, dst)
            return True
    return False


def ensure_pil_shim():
    """Satisfy script.module.pil, which no Kodi repository carries.

    plugin.video.themoviedb.helper -- which the skin needs -- lists
    script.module.pil as a hard requirement, but it is not in the
    official repo. Debian ships the actual library as python3-pil and it
    is already importable, so a small shim addon satisfies Kodi's
    dependency check without bundling a copy of Pillow.
    """
    aid = "script.module.pil"
    path = os.path.join(ADDONS, aid)
    if os.path.isdir(path):
        return True
    try:
        import PIL  # noqa: F401 -- only checking it exists system-wide
    except ImportError:
        log("! system python3-pil is missing; install it with:")
        log("    sudo apt-get install -y python3-pil")
        return False

    os.makedirs(os.path.join(path, "lib"), exist_ok=True)
    xml = [
        '<?xml version="1.0" encoding="UTF-8"?>',
        '<addon id="script.module.pil" name="pil" version="1.1.7"',
        '       provider-name="system">',
        '    <requires>',
        '        <import addon="xbmc.python" version="3.0.0"/>',
        '    </requires>',
        '    <extension point="xbmc.python.module" library="lib"/>',
        '    <extension point="xbmc.addon.metadata">',
        '        <summary lang="en_GB">Pillow, provided by the system</summary>',
        '        <description lang="en_GB">Shim for the system python3-pil',
        'package, which supplies PIL. Kodi has no repository copy.</description>',
        '        <platform>linux</platform>',
        '        <license>MIT</license>',
        '    </extension>',
        '</addon>',
    ]
    with open(os.path.join(path, "addon.xml"), "w", encoding="utf-8") as f:
        f.write(chr(10).join(xml) + chr(10))
    log("+ %s (shim over system python3-pil)" % aid)
    return True

def addon_requires(addon_id):
    """Dependency ids declared in an installed addon's addon.xml."""
    path = os.path.join(ADDONS, addon_id, "addon.xml")
    if not os.path.isfile(path):
        return []
    try:
        root = ET.parse(path).getroot()
    except ET.ParseError as exc:
        log("  ! cannot parse addon.xml for %s: %s" % (addon_id, exc))
        return []
    out = []
    for imp in root.findall("./requires/import"):
        dep = imp.get("addon")
        if dep and not BUILTIN.match(dep):
            out.append(dep)
    return out


def resolve_deps(addon_id, index, depth=0):
    if depth > 8:                      # guard against dependency cycles
        return
    for dep in addon_requires(addon_id):
        if not already_installed(dep):
            install_official(dep, index, depth + 1)


def install_official(addon_id, index, depth=0):
    """Install from the official repo, then its dependencies, recursively."""
    pad = "  " * (depth + 1)
    if already_installed(addon_id):
        return True
    if addon_id not in index:
        log("%s! %s is not in the official repo" % (pad, addon_id))
        return False
    ver = index[addon_id]
    url = "%s/%s/%s-%s.zip" % (KODI_REPO, addon_id, addon_id, ver)
    try:
        log("%s+ %s %s" % (pad, addon_id, ver))
        extract_zip(fetch(url), addon_id)
    except Exception as exc:
        log("%s! failed %s: %s" % (pad, addon_id, exc))
        return False
    resolve_deps(addon_id, index, depth)
    return True


def install_github(repo, branch, addon_id, index):
    if already_installed(addon_id, respect_force=True):
        return True
    url = "https://codeload.github.com/%s/zip/refs/heads/%s" % (repo, branch)
    try:
        log("+ %s (github %s@%s)" % (addon_id, repo, branch))
        extract_zip(fetch(url, timeout=180), addon_id, strip_root=True)
    except Exception as exc:
        log("! failed %s: %s" % (addon_id, exc))
        return False
    resolve_deps(addon_id, index)
    return True


def install_url(url, addon_id, index, strip_root=False):
    if already_installed(addon_id, respect_force=True):
        return True
    try:
        log("+ %s (%s)" % (addon_id, url.rsplit("/", 1)[-1]))
        extract_zip(fetch(url, timeout=180), addon_id, strip_root=strip_root)
    except Exception as exc:
        log("! failed %s: %s" % (addon_id, exc))
        return False
    resolve_deps(addon_id, index)
    return True


def install_jm_font(index):
    """resource.font.robotocjksc is not carried by the official repo."""
    try:
        xml = fetch(JM_ZIPS + "/addons.xml").decode("utf-8", "replace")
    except Exception as exc:
        log("! robotocjksc lookup failed: %s" % exc)
        return False
    m = re.search(r'addon id="(resource\.font\.robotocjksc)"'
                  r'[^>]*version="([^"]+)"', xml)
    if not m:
        log("! robotocjksc not listed in the jurialmunkey repo")
        return False
    aid, ver = m.group(1), m.group(2)
    return install_url("%s/%s/%s-%s.zip" % (JM_ZIPS, aid, aid, ver),
                       aid, index)


def latest_github_zip(repo):
    """browser_download_url of the newest .zip asset on a GitHub release."""
    data = fetch("https://api.github.com/repos/%s/releases/latest" % repo)
    rel = json.loads(data.decode("utf-8", "replace"))
    for asset in rel.get("assets", []):
        if asset.get("name", "").endswith(".zip"):
            return asset["browser_download_url"]
    return None


# AKL is split across four add-ons and only works with all of them:
#   plugin.program.akl            the launcher itself
#   script.module.akl             the shared library every other piece imports
#   script.akl.defaults           the folder scanner and local-files scraper
#   script.akl.retroarchlauncher  runs the ROMs through RetroArch
# Miss script.module.akl and AKL loads but dies with "No module named 'akl'";
# miss script.akl.defaults and it has no way to find ROMs at all.
AKL_ADDONS = (
    "plugin.program.akl",
    "script.module.akl",
    "script.akl.defaults",
    "script.akl.retroarchlauncher",
)

# distutils went away in Python 3.12 (PEP 632) and Kodi 21 on Trixie runs
# 3.13, but AKL 1.5.3 still imports distutils.version.LooseVersion in three
# files. Without this the add-on cannot even be imported.
AKL_DISTUTILS_USERS = (
    "resources/lib/repositories.py",
    "resources/lib/services.py",
    "resources/lib/commands/misc_commands.py",
)

VERSIONCOMPAT = '''\
# -*- coding: utf-8 -*-
#
# Stand-in for distutils.version.LooseVersion, removed in Python 3.12.
# Installed by Retro Pi 2.0; see AKL_DISTUTILS_USERS in retropi2-install-addons.
#
# Keeps distutils' parsing rules -- split into runs of digits and letters,
# drop the dots, make the digit runs ints -- so version ordering and AKL's
# database migration ordering behave exactly as AKL expects.
import re

_component_re = re.compile(r'(\\d+ | [a-z]+ | \\.)', re.VERBOSE)


class LooseVersion:

    def __init__(self, vstring=None):
        self.vstring = ''
        self.version = []
        if vstring:
            self.parse(str(vstring))

    def parse(self, vstring):
        self.vstring = vstring
        parts = [x for x in _component_re.split(vstring) if x and x != '.']
        for i, obj in enumerate(parts):
            try:
                parts[i] = int(obj)
            except ValueError:
                pass
        self.version = parts

    def __str__(self):
        return self.vstring

    def __repr__(self):
        return "LooseVersion ('%s')" % str(self)

    # Ints sort before strings, rather than the TypeError distutils raised.
    @staticmethod
    def _key(version):
        return [(0, v, '') if isinstance(v, int) else (1, 0, v)
                for v in version]

    def _cmp(self, other):
        if isinstance(other, str):
            other = LooseVersion(other)
        elif not isinstance(other, LooseVersion):
            return NotImplemented
        a, b = self._key(self.version), self._key(other.version)
        if a == b:
            return 0
        return -1 if a < b else 1

    def __eq__(self, other):
        c = self._cmp(other)
        return NotImplemented if c is NotImplemented else c == 0

    def __lt__(self, other):
        c = self._cmp(other)
        return NotImplemented if c is NotImplemented else c < 0

    def __le__(self, other):
        c = self._cmp(other)
        return NotImplemented if c is NotImplemented else c <= 0

    def __gt__(self, other):
        c = self._cmp(other)
        return NotImplemented if c is NotImplemented else c > 0

    def __ge__(self, other):
        c = self._cmp(other)
        return NotImplemented if c is NotImplemented else c >= 0

    def __hash__(self):
        return hash(tuple(self._key(self.version)))
'''


def patch_akl_for_python313():
    """Swap AKL's distutils import for a shim it ships alongside.

    Vendored into the add-on rather than dropped on sys.path as a fake
    top-level "distutils", so nothing else running inside Kodi is affected.
    Re-applied after every upgrade, since an AKL update restores the
    original imports.
    """
    akl = os.path.join(ADDONS, "plugin.program.akl")
    if not os.path.isdir(akl):
        return False

    shim = os.path.join(akl, "resources", "lib", "_versioncompat.py")
    try:
        with open(shim, "w") as fh:
            fh.write(VERSIONCOMPAT)
    except OSError as exc:
        log("! could not write AKL version shim: %s" % exc)
        return False

    old = "from distutils.version import LooseVersion"
    new = "from resources.lib._versioncompat import LooseVersion"
    patched = 0
    for rel in AKL_DISTUTILS_USERS:
        path = os.path.join(akl, rel)
        try:
            with open(path) as fh:
                text = fh.read()
        except OSError:
            continue
        if old in text:
            with open(path, "w") as fh:
                fh.write(text.replace(old, new))
            patched += 1

    # Stale .pyc files still hold the old import.
    for root, dirs, _files in os.walk(akl):
        for d in list(dirs):
            if d == "__pycache__":
                shutil.rmtree(os.path.join(root, d), ignore_errors=True)
                dirs.remove(d)

    log("  patched %d AKL file(s) for Python 3.13" % patched)
    return True


def patch_akl_retroarch_launcher():
    """Fix get_application() returning a FileName instead of a str on Linux.

    script.akl.retroarchlauncher's Windows branch returns app.getPath() but
    the Linux one returns the FileName object, and the base class then does
    string .replace() on it:

        AttributeError: 'FileName' object has no attribute 'replace'

    Every launch fails without this. Re-applied after each upgrade.
    """
    path = os.path.join(ADDONS, "script.akl.retroarchlauncher",
                        "resources", "lib", "launcher.py")
    if not os.path.exists(path):
        return False

    old = ("        if io.is_linux():\n"
           "            app = io.FileName(self.launcher_settings['application'])\n"
           "            return app\n")
    new = ("        if io.is_linux():\n"
           "            app = io.FileName(self.launcher_settings['application'])\n"
           "            # Must be a str: the base class runs .replace() on it.\n"
           "            return app.getPath()\n")

    try:
        with open(path) as fh:
            text = fh.read()
    except OSError as exc:
        log("! could not read RetroArch launcher: %s" % exc)
        return False

    if new in text:
        return True
    if old not in text:
        log("! RetroArch launcher has changed; skipping Linux path fix")
        return False

    with open(path, "w") as fh:
        fh.write(text.replace(old, new))

    for root, dirs, _files in os.walk(
            os.path.join(ADDONS, "script.akl.retroarchlauncher")):
        for d in list(dirs):
            if d == "__pycache__":
                shutil.rmtree(os.path.join(root, d), ignore_errors=True)
                dirs.remove(d)

    log("  patched RetroArch launcher for Linux")
    return True


def install_akl(index):
    """Advanced Kodi Launcher -- games with artwork, launched via RetroArch."""
    ok = True
    # Use release assets rather than branches: the default branch is "main",
    # and a source archive is not a packaged Kodi addon anyway.
    for repo in AKL_ADDONS:
        try:
            url = latest_github_zip("chrisism/" + repo)
            if url:
                ok = install_url(url, repo, index) and ok
            else:
                log("! no zip asset on the latest %s release" % repo)
                ok = False
        except Exception as exc:
            log("! %s install failed: %s" % (repo, exc))
            ok = False

    patch_akl_for_python313()
    patch_akl_retroarch_launcher()
    return ok


def install_jellyfin(index):
    """Jellyfin for Kodi, from the Jellyfin project's own repository."""
    base = "https://repo.jellyfin.org/releases/client/kodi/py3"
    try:
        listing = fetch(base + "/addons.xml").decode("utf-8", "replace")
        m = re.search(r'addon id="(plugin\.video\.jellyfin)"'
                      r'[^>]*version="([^"]+)"', listing)
        if not m:
            log("! jellyfin addon not listed in its repo")
            return False
        aid, ver = m.group(1), m.group(2)
        return install_url("%s/%s/%s-%s.zip" % (base, aid, aid, ver),
                           aid, index)
    except Exception as exc:
        log("! jellyfin install failed: %s" % exc)
        return False


def set_skin(skin_id):
    """Merge the skin choice into guisettings.xml.

    The image ships a guisettings.xml with the web-remote and CEC
    settings already in it, so this must merge rather than bail out or
    overwrite -- an earlier version skipped when the file existed, which
    meant the skin was never applied.

    Safe to set optimistically: Kodi falls back to Estuary by itself if a
    skin fails to load.
    """
    os.makedirs(USERDATA, exist_ok=True)
    path = os.path.join(USERDATA, "guisettings.xml")

    root = None
    if os.path.exists(path):
        try:
            root = ET.parse(path).getroot()
        except ET.ParseError as exc:
            log("guisettings.xml is unparseable (%s); rewriting it" % exc)
            root = None
    if root is None:
        root = ET.Element("settings", {"version": "2"})

    for node in root.findall("setting"):
        if node.get("id") == "lookandfeel.skin":
            if node.text == skin_id:
                log("skin already set to %s" % skin_id)
                return
            node.text = skin_id
            break
    else:
        node = ET.SubElement(root, "setting", {"id": "lookandfeel.skin"})
        node.text = skin_id

    ET.ElementTree(root).write(path, encoding="utf-8", xml_declaration=True)
    log("skin set to %s" % skin_id)


def main():
    os.makedirs(ADDONS, exist_ok=True)

    try:
        index = load_official_index()
    except Exception as exc:
        log("could not reach the Kodi repository (%s)" % exc)
        log("Kodi will start on the default skin. Re-run later with:")
        log("  sudo systemctl start retropi2-addons")
        return 1

    results = {}

    # The skin, plus the two dependencies the official repo lacks.
    results["texturemaker"] = install_github(
        "jurialmunkey/script.texturemaker", "main",
        "script.texturemaker", index)
    results["robotocjksc"] = install_jm_font(index)
    results["skin"] = install_github(
        "jurialmunkey/skin.arctic.horizon.2", "omega", SKIN_ID, index)

    # Games and media.
    results["pil_shim"] = ensure_pil_shim()
    results["akl"] = install_akl(index)

    # YouTube. Note this will not play anything until the owner adds their
    # own Google API key in the add-on's settings -- since 2019 there are no
    # working shared keys, and the add-on just logs "Request skipped: API key
    # not provided". Installed anyway so the menu entry works and the setup
    # is a couple of screens rather than a whole install.
    results["youtube"] = install_official("plugin.video.youtube", index)
    results["jellyfin"] = install_jellyfin(index)

    # Upstream ships at least one addon whose folder name does not match
    # its declared id; fix those before deciding whether the skin is usable.
    for aid in ("resource.font.robotocjksc", "script.texturemaker",
                SKIN_ID, "plugin.video.themoviedb.helper"):
        reconcile_addon_dir(aid)

    if results.get("skin") and already_installed(SKIN_ID):
        set_skin(SKIN_ID)
    else:
        log("skin unavailable -- Kodi will use the stock Estuary skin")

    os.makedirs(os.path.dirname(DONE_FLAG), exist_ok=True)
    with open(DONE_FLAG, "w", encoding="utf-8") as f:
        for key in sorted(results):
            f.write("%s=%s\n" % (key, "ok" if results[key] else "failed"))

    log("summary: " + ", ".join(
        "%s=%s" % (k, "ok" if results[k] else "FAILED")
        for k in sorted(results)))
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main())
    except Exception as exc:        # never block the boot
        log("unexpected error: %s" % exc)
        sys.exit(1)
