[Unit]
Description=Kodi Media Center (GBM, no desktop)
After=systemd-user-sessions.service network-online.target sound.target retropi2-addons.service
# Take the console over from the login prompt rather than fighting it.
Conflicts=getty@tty1.service
After=getty@tty1.service
Wants=network-online.target

[Service]
User=pi
Group=pi
# GBM needs direct GPU access; input needs evdev. Without these Kodi
# starts with no picture and no controller.
SupplementaryGroups=video render input audio tty dialout plugdev
Type=simple
Environment=HOME=/home/pi
ExecStart=/usr/bin/kodi-standalone
Restart=on-failure
RestartSec=5
# Deliberately NOT bound to a tty. getty owns tty1 for the login prompt,
# and asking for it here makes kodi-standalone hang at startup with the
# service still reporting "active". Kodi on GBM renders straight to the
# GPU and reads input via evdev, so it needs no controlling terminal.
StandardInput=null
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
